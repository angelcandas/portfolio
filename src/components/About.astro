---
import { copy, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const t = copy[Astro.props.lang].about;
---
<section id="about" class="section section--alt about" aria-labelledby="about-title">
  <div class="wrap">
    <div class="about__intro">
      <div class="section-head">
        <p class="eyebrow">{t.label}</p>
        <h2 id="about-title">{t.title}</h2>
        {t.body.map((p) => <p class="lead">{p}</p>)}
      </div>
      <dl class="details card">
        {t.details.map((d) => (
          <div><dt>{d.k}</dt><dd>{d.v.map((v) => <span>{v}</span>)}</dd></div>
        ))}
      </dl>
    </div>

    <h3 class="eyebrow caps__label">{t.capsLabel}</h3>
    <ul role="list" class="caps">
      {t.caps.map((c) => (
        <li class="cap" data-reveal>
          <h4>{c.title}</h4>
          <ul role="list">{c.items.map((it) => <li>{it}</li>)}</ul>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about__intro { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .about .section-head { margin: 0; justify-items: start; text-align: left; }
  .about .lead { font-size: 19px; }
  .details { padding: 8px 28px; }
  .details div { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 12px; padding-block: 14px; }
  .details div + div { border-top: 1px solid var(--line); }
  .details dt { font-size: 14px; font-weight: 500; color: var(--muted); padding-top: 3px; }
  .details dd { display: grid; gap: 2px; font-size: 16px; }
  .caps__label { margin-top: clamp(72px, 8vw, 112px); margin-bottom: 28px; font-size: clamp(28px, 3vw, 40px); font-weight: 700; letter-spacing: -0.035em; color: var(--fg); }
  .caps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .cap { padding: 26px; border-radius: var(--radius); background: var(--card); }
  .cap h4 { font-size: 19px; font-weight: 700; letter-spacing: -0.02em; }
  .cap ul { margin-top: 14px; display: grid; gap: 8px; color: var(--fg-2); font-size: 15px; }
  @media (max-width: 960px) {
    .about__intro { grid-template-columns: 1fr; }
    .caps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .caps { grid-template-columns: 1fr; }
    .details div { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
