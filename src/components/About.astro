---
import { copy, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const t = copy[Astro.props.lang].about;
---
<section id="about" class="section about" aria-labelledby="about-title">
  <div class="wrap">
    <div class="about__intro">
      <p class="label">{t.label}</p>
      <h2 id="about-title" data-reveal>{t.title}</h2>
      <div class="about__body">
        {t.body.map((p, i) => <p data-reveal style={`--d:${i}`}>{p}</p>)}
      </div>
    </div>

    <h3 class="sub label">{t.capsLabel}</h3>
    <ul role="list" class="caps">
      {t.caps.map((c, i) => (
        <li class="cap" data-reveal style={`--d:${i}`}>
          <span class="cap__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h4>{c.title}</h4>
          <ul role="list">{c.items.map((it) => <li>{it}</li>)}</ul>
        </li>
      ))}
    </ul>

    <h3 class="sub label">{t.expLabel}</h3>
    <ol role="list" class="exp">
      {t.exp.map((e, i) => (
        <li data-reveal style={`--d:${i}`}>
          <h4>{e.org}</h4>
          <p class="role">{e.role}</p>
          <p class="txt">{e.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .about { background: var(--bg-2); border-top: 1px solid var(--line); }
  .about__intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px clamp(32px, 6vw, 96px); align-items: end; padding-bottom: clamp(72px, 10vw, 140px); }
  .about__intro .label { grid-column: 1 / -1; }
  .about__intro h2 { font-size: clamp(44px, 6.6vw, 112px); font-weight: 500; letter-spacing: -0.055em; font-variation-settings: 'wdth' 82; }
  .about__body { display: grid; gap: 18px; font-size: clamp(17px, 1.3vw, 21px); color: var(--fg-2); max-width: 46ch; }
  .about__body p:first-child { color: var(--fg); }

  .sub { margin-bottom: 24px; }
  .caps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--line); margin-bottom: clamp(72px, 10vw, 140px); }
  .cap { padding: 28px 24px 32px 0; border-right: 1px solid var(--line); display: grid; gap: 14px; align-content: start; position: relative; }
  .cap + .cap { padding-left: 24px; }
  .cap:last-child { border-right: 0; }
  .cap::before { content: ''; position: absolute; left: 0; right: 0; top: -1px; height: 1px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 0.8s var(--ease-out); }
  .cap:hover::before { transform: scaleX(1); }
  .cap__n { font-family: var(--f-mono); font-size: 12px; color: var(--accent); }
  .cap h4 { font-size: clamp(22px, 2vw, 30px); font-weight: 500; letter-spacing: -0.03em; }
  .cap ul { display: grid; gap: 6px; color: var(--fg-2); font-size: 14.5px; }

  .exp { border-top: 1px solid var(--line); }
  .exp li { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 3fr) minmax(0, 5fr); gap: 8px 32px; padding: 28px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .exp h4 { font-size: clamp(22px, 2.2vw, 34px); font-weight: 500; letter-spacing: -0.035em; }
  .role { font-family: var(--f-mono); font-size: 12.5px; color: var(--accent); }
  .txt { color: var(--fg-2); font-size: 15px; }

  @media (max-width: 1024px) {
    .caps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cap:nth-child(2) { border-right: 0; }
    .cap:nth-child(3) { padding-left: 0; }
    .cap:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
  @media (max-width: 760px) {
    .about__intro { grid-template-columns: 1fr; }
    .exp li { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .caps { grid-template-columns: 1fr; }
    .cap, .cap + .cap { padding-left: 0; border-right: 0; }
    .cap + .cap { border-top: 1px solid var(--line); }
  }
</style>
