---
import { Picture } from 'astro:assets';
import { copy, projectMeta, smallProjects, signInRequired, type Lang } from '../i18n/content';
import micfxMixer from '../assets/projects/micfx-mixer.png';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
const isEs = lang === 'es';
const ct = t.projects.cryptotax;
const mf = t.projects.micfx;
const arrow = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<section id="work" class="section work" aria-labelledby="work-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{t.work.label}</p>
      <h2 id="work-title">{t.work.title}</h2>
      <p class="lead">{t.work.lead}</p>
    </div>

    <div class="feats">
      <!-- Crypto Tax ES: the fintech project. Private source, so it is shown as its data flow. -->
      <article class="feat card" aria-labelledby="p-cryptotax" data-reveal>
        <div class="feat__media feat__media--flow">
          <p class="eyebrow">{ct.flowLabel}</p>
          <ol role="list" class="pipe">
            {ct.flow.map((f, i) => <li><span class="pipe__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{f}</li>)}
          </ol>
        </div>
        <div class="feat__body">
          <p class="feat__meta">{projectMeta.cryptotax.year}<span class="private">{t.work.private}</span></p>
          <h3 id="p-cryptotax" class="feat__name">{ct.name}</h3>
          <p class="feat__tag">{ct.tag}</p>
          <p class="feat__summary">{ct.summary}</p>
          <ul role="list" class="chips">{projectMeta.cryptotax.stack.map((s) => <li>{s}</li>)}</ul>
        </div>
      </article>

      <article class="feat card" aria-labelledby="p-micfx" data-reveal>
        <figure class="feat__media feat__media--shot">
          <Picture src={micfxMixer} formats={['avif', 'webp']} widths={[600, 900, 1200]} sizes="(max-width: 960px) 100vw, 560px" alt={isEs ? 'MicFX en modo DAW: pistas, mezclador con envíos de reverb y chorus y biblioteca de sonidos.' : 'MicFX in DAW mode: tracks, a mixer with reverb and chorus sends, and the sound library.'} />
        </figure>
        <div class="feat__body">
          <p class="feat__meta">{projectMeta.micfx.year}</p>
          <h3 id="p-micfx" class="feat__name">{mf.name}</h3>
          <p class="feat__tag">{mf.tag}</p>
          <p class="feat__summary">{mf.summary}</p>
          <dl class="stats">
            {mf.stats.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
          </dl>
          <ul role="list" class="chips">{projectMeta.micfx.stack.map((s) => <li>{s}</li>)}</ul>
          <div class="links">
            {projectMeta.micfx.links.map((l) => (
              <a class="link" href={l.href} target="_blank" rel="noopener">{l.label}<span class="sr-only"> · {mf.name}</span><Fragment set:html={arrow} /></a>
            ))}
          </div>
        </div>
      </article>
    </div>

    <h3 class="eyebrow more__label">{t.work.more}</h3>
    <ul role="list" class="more">
      {smallProjects.map((id) => {
        const p = t.projects[id];
        const m = projectMeta[id];
        return (
          <li class="mini" data-reveal>
            <article aria-labelledby={`p-${id}`}>
              <h4 id={`p-${id}`} class="mini__name">{p.name}</h4>
              <p class="mini__tag">{p.tag}</p>
              <p class="mini__summary">{p.summary}</p>
              <ul role="list" class="chips">{m.stack.map((s) => <li>{s}</li>)}</ul>
              {m.links.length > 0 && <div class="links">
                {m.links.map((l) => (
                  <a class="link" href={l.href} target="_blank" rel="noopener">
                    {l.label === 'App' && signInRequired.includes(id) ? t.work.signin : l.label}<span class="sr-only"> · {p.name}</span><Fragment set:html={arrow} />
                  </a>
                ))}
              </div>}
            </article>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .feats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .feat { overflow: hidden; display: flex; flex-direction: column; }
  .feat__media { border-bottom: 1px solid var(--line); background: var(--surface-2); aspect-ratio: 16 / 10; }
  .feat__media--shot { overflow: hidden; display: grid; place-items: end center; padding: 24px 24px 0; }
  .feat__media--shot :global(picture), .feat__media--shot :global(img) { width: 100%; border-radius: 8px 8px 0 0; box-shadow: 0 0 0 1px var(--line), 0 12px 32px -12px rgb(0 0 0 / 0.35); }
  .feat__media--flow { padding: clamp(20px, 2.6vw, 32px); display: grid; align-content: center; gap: 14px; background: radial-gradient(90% 90% at 100% 0%, var(--accent-soft), transparent 70%), var(--surface-2); }
  .pipe { display: grid; gap: 8px; }
  .pipe li { display: flex; align-items: center; gap: 14px; padding: 11px 14px; border-radius: 10px; border: 1px solid var(--line); background: var(--surface); font-size: 16px; font-weight: 600; letter-spacing: -0.01em; position: relative; }
  .pipe li + li::before { content: ''; position: absolute; left: 27px; top: -9px; width: 1px; height: 8px; background: var(--line-2); }
  .pipe li:last-child { border-color: var(--accent); color: var(--accent); }
  .pipe__n { font-family: var(--f-mono); font-size: 12px; color: var(--muted); font-weight: 500; }

  .feat__body { padding: clamp(22px, 2.6vw, 32px); display: flex; flex-direction: column; gap: 0; flex: 1; }
  .feat__meta { display: flex; align-items: center; gap: 10px; font-family: var(--f-mono); font-size: 12.5px; color: var(--muted); }
  .private { font-size: 12px; padding: 2px 8px; border-radius: 6px; border: 1px solid var(--line-2); color: var(--fg-2); }
  .feat__name { margin-top: 10px; font-size: 26px; letter-spacing: -0.028em; }
  .feat__tag { margin-top: 4px; font-size: 15px; font-weight: 550; color: var(--accent); }
  .feat__summary { margin-top: 12px; color: var(--fg-2); font-size: 15.5px; }
  .feat .chips { margin-top: 18px; }
  .stats { margin-top: 18px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-block: 1px solid var(--line); }
  .stats div { padding: 12px 10px 12px 0; display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 2px; }
  .stats div + div { padding-left: 14px; border-left: 1px solid var(--line); }
  .stats dd { font-size: 22px; font-weight: 650; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }
  .stats dt { font-size: 12.5px; color: var(--muted); line-height: 1.35; }
  .links { display: flex; flex-wrap: wrap; gap: 0 20px; margin-top: auto; padding-top: 12px; }

  .more__label { margin-top: clamp(48px, 5vw, 72px); margin-bottom: 16px; }
  .more { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); column-gap: 40px; }
  .mini { padding: 22px 0 8px; border-top: 1px solid var(--line); }
  .mini article { height: 100%; display: flex; flex-direction: column; }
  .mini__name { font-size: 18px; letter-spacing: -0.018em; }
  .mini__tag { margin-top: 2px; font-size: 13.5px; color: var(--muted); }
  .mini__summary { margin-top: 10px; color: var(--fg-2); font-size: 14.5px; line-height: 1.55; }
  .mini .chips { margin-top: 12px; }

  @media (max-width: 960px) {
    .feats { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .feat__media { aspect-ratio: auto; }
  }
</style>
