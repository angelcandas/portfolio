---
import { Picture } from 'astro:assets';
import { copy, projectMeta, smallProjects, signInRequired, type Lang } from '../i18n/content';
import micfxMixer from '../assets/projects/micfx-mixer.png';
import quecomoShot from '../assets/projects/quecomo.png';
import llanesShot from '../assets/projects/llanes.png';
import carlogIcon from '../assets/projects/carlog-icon.svg?raw';
import homelogIcon from '../assets/projects/homelog-icon.svg?raw';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
const isEs = lang === 'es';
const ct = t.projects.cryptotax;
const mf = t.projects.micfx;
const arrow = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<section id="work" class="section work" aria-labelledby="work-title">
  <div class="wrap">
    <div class="section-head">
      <p class="label">{t.work.label}</p>
      <h2 id="work-title" data-reveal>{t.work.title}</h2>
    </div>

    <!-- Crypto Tax ES: the fintech project. No public screenshot yet, so it is shown as a flow. -->
    <article class="feat feat--crypto" aria-labelledby="p-cryptotax">
      <div class="feat__text">
        <p class="proj__idx" data-reveal>{projectMeta.cryptotax.year} · <span class="private">{t.work.private}</span></p>
        <h3 id="p-cryptotax" class="feat__name" data-reveal>{ct.name}</h3>
        <p class="proj__tag" data-reveal>{ct.tag}</p>
        <p class="feat__summary" data-reveal>{ct.summary}</p>
        <ul role="list" class="chips" data-reveal>{projectMeta.cryptotax.stack.map((s) => <li>{s}</li>)}</ul>
      </div>
      <div class="pipe" data-reveal>
        <p class="pipe__label">{ct.flowLabel}</p>
        <ol role="list" class="pipe__steps">
          {ct.flow.map((f, i) => <li><span class="pipe__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{f}</li>)}
        </ol>
      </div>
    </article>

    <!-- MicFX -->
    <article class="feat feat--micfx" aria-labelledby="p-micfx">
      <figure class="shot" data-reveal>
        <Picture src={micfxMixer} formats={['avif', 'webp']} widths={[600, 900, 1200]} sizes="(max-width: 960px) 100vw, 46vw" alt={isEs ? 'MicFX en modo DAW: pistas, mezclador con envíos de reverb y chorus y biblioteca de sonidos.' : 'MicFX in DAW mode: tracks, a mixer with reverb and chorus sends, and the sound library.'} />
      </figure>
      <div class="feat__text">
        <p class="proj__idx" data-reveal>{projectMeta.micfx.year}</p>
        <h3 id="p-micfx" class="feat__name" data-reveal>{mf.name}</h3>
        <p class="proj__tag" data-reveal>{mf.tag}</p>
        <p class="feat__summary" data-reveal>{mf.summary}</p>
        <dl class="stats" data-reveal>
          {mf.stats.map((s) => (
            <div class="stat"><dt>{s.label}</dt><dd>{s.count !== undefined ? <span data-count={s.count}>{s.value}</span> : s.value}</dd></div>
          ))}
        </dl>
        <div class="proj__links" data-reveal>
          <ul role="list" class="chips">{projectMeta.micfx.stack.map((s) => <li>{s}</li>)}</ul>
          {projectMeta.micfx.links.map((l) => (
            <a class="link" href={l.href} target="_blank" rel="noopener">{l.label}<span class="sr-only"> · {mf.name}</span><Fragment set:html={arrow} /></a>
          ))}
        </div>
      </div>
    </article>

    <!-- Small apps -->
    <ul role="list" class="grid">
      {smallProjects.map((id, i) => {
        const p = t.projects[id];
        const m = projectMeta[id];
        return (
          <li class={`card card--${id}`} data-reveal style={`--d:${i}`}>
            <article aria-labelledby={`p-${id}`}>
              <div class="card__media" aria-hidden={id === 'carlog' || id === 'homelog' ? 'true' : undefined}>
                {id === 'quecomo' && <div class="phone"><Picture src={quecomoShot} formats={['avif', 'webp']} widths={[240, 480]} sizes="160px" alt={isEs ? 'Pantalla «Hoy» de ¿Qué como?.' : '“Today” screen of ¿Qué como?.'} /></div>}
                {id === 'llanes' && <div class="browser"><Picture src={llanesShot} formats={['avif', 'webp']} widths={[400, 800]} sizes="(max-width: 640px) 90vw, 300px" alt={isEs ? 'Portada de la Guía de Llanes.' : 'Llanes Guide home page.'} /></div>}
                {(id === 'carlog' || id === 'homelog') && <div class="icon" set:html={id === 'carlog' ? carlogIcon : homelogIcon} />}
              </div>
              <div class="card__body">
                <h3 id={`p-${id}`} class="card__name">{p.name}</h3>
                <p class="proj__tag">{p.tag}</p>
                <p class="card__summary">{p.summary}</p>
                <ul role="list" class="chips">{m.stack.map((s) => <li>{s}</li>)}</ul>
                <div class="proj__links">
                  {m.links.map((l) => (
                    <a class="link" href={l.href} target="_blank" rel="noopener">
                      {l.label === 'App' && signInRequired.includes(id) ? t.work.signin : l.label}<span class="sr-only"> · {p.name}</span><Fragment set:html={arrow} />
                    </a>
                  ))}
                </div>
              </div>
            </article>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .work { padding-block: clamp(56px, 5vw, 80px); }
  .work .section-head { margin-bottom: clamp(32px, 4vw, 56px); padding-bottom: clamp(24px, 3vw, 40px); }
  .work .section-head h2 { font-size: clamp(44px, 6vw, 100px); }
  .proj__idx { font-family: var(--f-mono); font-size: 12px; letter-spacing: 0.1em; color: var(--muted); margin-bottom: 12px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .proj__tag { font-family: var(--f-mono); font-size: 13px; color: var(--accent); margin-top: 10px; letter-spacing: 0.02em; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chips li { font-family: var(--f-mono); font-size: 11.5px; padding: 5px 10px; border-radius: 999px; border: 1px solid var(--line); color: var(--fg-2); }
  .proj__links { display: flex; flex-wrap: wrap; gap: 12px 22px; align-items: center; margin-top: 20px; }
  .private { font-family: var(--f-mono); font-size: 11.5px; letter-spacing: 0.04em; color: var(--fg-2); display: inline-flex; align-items: center; gap: 6px; padding: 3px 9px; border: 1px solid var(--line-2); border-radius: 999px; }
  .private::before { content: ''; width: 6px; height: 6px; border-radius: 2px; border: 1px solid currentColor; }

  /* Feature rows */
  .feat { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 80px); align-items: center; padding-bottom: clamp(36px, 4vw, 56px); }
  .feat + .feat { padding-top: clamp(36px, 4vw, 56px); border-top: 1px solid var(--line); }
  .feat__name { font-size: clamp(40px, 5vw, 84px); font-weight: 600; letter-spacing: -0.055em; font-variation-settings: 'wdth' 80; line-height: 0.9; }
  .feat__summary { margin-top: 18px; font-size: clamp(16px, 1.15vw, 18px); color: var(--fg-2); max-width: 50ch; }
  .feat .chips { margin-top: 20px; }
  .feat .proj__links .chips { margin-top: 0; }

  .pipe { border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(20px, 2.4vw, 32px); background: radial-gradient(120% 120% at 100% 0%, rgb(200 255 61 / 0.08), transparent 60%), var(--bg-2); }
  .pipe__label { font-family: var(--f-mono); font-size: 11.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .pipe__steps { margin-top: 14px; display: grid; gap: 8px; }
  .pipe__steps li { display: flex; align-items: center; gap: 16px; padding: 11px 18px; border-radius: 14px; border: 1px solid var(--line); background: rgb(255 255 255 / 0.03); font-family: var(--f-display); font-size: clamp(18px, 1.6vw, 24px); letter-spacing: -0.02em; position: relative; }
  .pipe__steps li + li::before { content: ''; position: absolute; left: 34px; top: -11px; width: 1px; height: 10px; background: var(--accent); }
  .pipe__steps li:last-child { border-color: var(--accent); color: var(--accent); }
  .pipe__n { font-family: var(--f-mono); font-size: 11.5px; color: var(--muted); letter-spacing: 0.08em; }

  .shot { border-radius: var(--radius); overflow: hidden; background: var(--bg-3); border: 1px solid var(--line); box-shadow: 0 30px 90px -40px rgb(124 107 255 / 0.35), 0 20px 60px -30px #000; }
  .shot :global(img) { width: 100%; }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 22px; border-top: 1px solid var(--line); }
  .stat { padding: 16px 12px 0 0; display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 6px; }
  .stat + .stat { padding-left: 16px; border-left: 1px solid var(--line); }
  .stat dt { font-size: 12.5px; color: var(--muted); line-height: 1.35; }
  .stat dd { font-family: var(--f-display); font-size: clamp(30px, 2.8vw, 46px); font-weight: 500; letter-spacing: -0.045em; line-height: 1; font-variant-numeric: tabular-nums; white-space: nowrap; }

  /* Small cards */
  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(16px, 2vw, 28px); padding-top: clamp(36px, 4vw, 56px); border-top: 1px solid var(--line); }
  .card article { height: 100%; display: flex; flex-direction: column; }
  .card__media {
    --bg: #1a1a1f;
    position: relative; aspect-ratio: 16 / 9; border-radius: 16px; overflow: hidden; background: var(--bg);
    display: grid; place-items: center;
  }
  .card__media::after { content: ''; position: absolute; inset: 0; border-radius: inherit; border: 1px solid rgb(255 255 255 / 0.08); pointer-events: none; }
  .card--quecomo .card__media { --bg: radial-gradient(120% 90% at 30% 0%, #6e8f2f 0%, #34481a 55%, #1b250e 100%); }
  .card--llanes .card__media { --bg: radial-gradient(120% 90% at 70% 0%, #c88b3a 0%, #6b4a1f 50%, #2a1d0d 100%); }
  .card--carlog .card__media { --bg: radial-gradient(120% 90% at 50% 0%, #5b6573 0%, #262a31 55%, #121417 100%); }
  .card--homelog .card__media { --bg: radial-gradient(120% 90% at 50% 0%, #3f7a80 0%, #234a4e 55%, #11272a 100%); }
  .phone { width: 34%; border-radius: 18px; padding: 4px; background: #0b0b0d; transform: translateY(26%) rotate(-4deg); box-shadow: 0 20px 40px -20px rgb(0 0 0 / 0.8); transition: transform 0.8s var(--ease-out); }
  .phone :global(img) { border-radius: 14px; }
  .browser { width: 82%; border-radius: 8px; overflow: hidden; transform: translate(6%, 14%); box-shadow: 0 20px 40px -20px rgb(0 0 0 / 0.8); transition: transform 0.8s var(--ease-out); }
  .card:hover .phone { transform: translateY(20%) rotate(-1deg); }
  .card:hover .browser { transform: translate(4%, 10%); }
  .icon { width: 30%; filter: drop-shadow(0 16px 30px rgb(0 0 0 / 0.5)); }
  .icon :global(svg) { width: 100%; height: auto; }
  .card__body { padding-top: 18px; display: flex; flex-direction: column; flex: 1; }
  .card__name { font-size: clamp(24px, 2vw, 32px); font-weight: 500; letter-spacing: -0.04em; }
  .card .proj__tag { font-size: 12px; }
  .card__summary { margin-top: 10px; color: var(--fg-2); font-size: 14.5px; line-height: 1.5; }
  .card .chips { margin-top: 14px; }
  .card .proj__links { margin-top: auto; padding-top: 10px; }

  .link { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-weight: 600; font-size: 15px; position: relative; }
  .link::after { content: ''; position: absolute; left: 0; right: 24px; bottom: 9px; height: 1px; background: var(--accent); transform-origin: left; transition: transform 0.5s var(--ease-out); }
  .link:hover::after { transform: scaleX(0); transform-origin: right; }
  .link :global(svg) { width: 14px; height: 14px; color: var(--accent); transition: transform 0.5s var(--ease-out); }
  .link:hover :global(svg) { transform: translate(3px, -3px); }

  @media (max-width: 1080px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 40px; }
  }
  @media (max-width: 860px) {
    .feat { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .grid { grid-template-columns: 1fr; }
  }
</style>
