---
import { copy, site, type Lang } from '../i18n/content';
import { hasCv } from '../lib/cv';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
const out = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<section id="contact" class="section contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="panel card">
      <div>
        <p class="eyebrow">{t.contact.label}</p>
        <h2 id="contact-title" class="panel__title">{t.contact.title}</h2>
        <p class="panel__body">{t.contact.body}</p>
      </div>
      <div class="panel__actions">
        {site.email[lang] && <a class="btn btn--primary panel__mail" href={`mailto:${site.email[lang]}`}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3.5h12v9H2zM2.5 4l5.5 4.5L13.5 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>{site.email[lang]}</a>}
        <div class="panel__row">
          <a class="btn" href={site.linkedin} target="_blank" rel="me noopener">LinkedIn<Fragment set:html={out} /></a>
          <a class="btn" href={site.github} target="_blank" rel="me noopener">GitHub<Fragment set:html={out} /></a>
          {hasCv && <a class="btn" href={site.cv} download>{t.cv}</a>}
        </div>
      </div>
    </div>
  </div>

  <footer class="wrap">
    <div class="foot">
      <p>© {new Date().getFullYear()} {t.footer.built}</p>
      <p>{lang === 'es' ? 'Valencia, España' : 'Valencia, Spain'} · {t.footer.local} <time data-clock>--:--</time></p>
      <a href="#top" class="totop">{t.footer.top} ↑</a>
    </div>
  </footer>
</section>

<style>
  .contact { padding-bottom: 0; }
  .panel { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 32px; align-items: end; padding: clamp(28px, 4vw, 56px); background: radial-gradient(80% 120% at 100% 100%, var(--accent-soft), transparent 70%), var(--surface); }
  .panel__title { margin-top: 12px; font-size: clamp(28px, 3.2vw, 42px); letter-spacing: -0.032em; max-width: 20ch; }
  .panel__body { margin-top: 12px; color: var(--fg-2); font-size: 17px; }
  .panel__actions { display: grid; gap: 10px; }
  .panel__row { display: flex; gap: 10px; flex-wrap: wrap; }
  .panel__row .btn { flex: 1; }
  .panel__mail { min-height: 52px; font-size: 16px; }
  .foot { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px 24px; align-items: center; margin-top: clamp(64px, 8vw, 112px); padding-block: 20px; border-top: 1px solid var(--line); font-size: 13.5px; color: var(--muted); }
  .foot time { color: var(--fg); font-variant-numeric: tabular-nums; font-family: var(--f-mono); font-size: 13px; }
  .totop { min-height: 44px; display: inline-flex; align-items: center; }
  .totop:hover { color: var(--fg); }
  @media (max-width: 860px) {
    .panel { grid-template-columns: 1fr; align-items: start; }
  }
</style>
