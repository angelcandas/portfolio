---
import { archive, copy, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const t = copy[Astro.props.lang].archive;
---
<section class="section archive" aria-labelledby="archive-title">
  <div class="wrap">
    <div class="archive__head">
      <p class="label">{t.label}</p>
      <h2 id="archive-title" data-reveal>{t.title}</h2>
    </div>
    <table class="table">
      <caption class="sr-only">{t.title}</caption>
      <thead>
        <tr>{t.cols.map((c) => <th scope="col">{c}</th>)}<th scope="col"><span class="sr-only">GitHub</span></th></tr>
      </thead>
      <tbody>
        {archive.map((a, i) => (
          <tr data-reveal style={`--d:${i}`}>
            <td class="y">{a.year}</td>
            <th scope="row"><a href={a.href} target="_blank" rel="noopener" class="row-link">{a.name}</a></th>
            <td class="s">{a.stack}</td>
            <td class="go" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M5 11l6-6M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .archive { padding-top: 0; }
  .archive__head { display: grid; gap: 20px; margin-bottom: 40px; }
  .archive__head h2 { font-size: clamp(40px, 6vw, 96px); font-weight: 500; letter-spacing: -0.05em; font-variation-settings: 'wdth' 85; }
  .table { width: 100%; border-collapse: collapse; }
  thead th { text-align: left; font-family: var(--f-mono); font-size: 11px; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); padding: 0 0 14px; border-bottom: 1px solid var(--line); }
  tbody tr { position: relative; border-bottom: 1px solid var(--line); transition: background 0.4s; }
  tbody tr:hover { background: rgb(255 255 255 / 0.03); }
  td, tbody th { padding: 24px 0; vertical-align: middle; text-align: left; }
  .y { font-family: var(--f-mono); font-size: 13px; color: var(--muted); width: 12%; }
  tbody th { font-family: var(--f-display); font-size: clamp(20px, 2.2vw, 32px); font-weight: 500; letter-spacing: -0.03em; }
  .row-link { transition: color 0.3s, padding 0.6s var(--ease-out); }
  .row-link::after { content: ''; position: absolute; inset: 0; }
  tbody tr:hover .row-link { color: var(--accent); padding-left: 12px; }
  .s { color: var(--muted); font-size: 14px; }
  .go { width: 32px; color: var(--muted); }
  .go svg { width: 18px; height: 18px; transition: transform 0.5s var(--ease-out), color 0.3s; }
  tbody tr:hover .go svg { transform: translate(3px, -3px); color: var(--accent); }
  @media (max-width: 720px) {
    thead { display: none; }
    tbody tr { display: grid; grid-template-columns: 1fr auto; padding: 18px 0; }
    td, tbody th { padding: 0; }
    .y { grid-row: 1; width: auto; }
    tbody th { grid-column: 1; }
    .s { grid-column: 1; margin-top: 4px; }
    .go { grid-column: 2; grid-row: 1 / 4; align-self: center; }
  }
</style>
