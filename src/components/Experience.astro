---
import { copy, perf, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const t = copy[Astro.props.lang].experience;
const c = t.case;
---
<section id="experience" class="section section--alt exp" aria-labelledby="exp-title">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{t.label}</p>
      <h2 id="exp-title">{t.title}</h2>
    </div>

    <article class="case card" data-reveal aria-labelledby="case-title">
      <div class="case__main">
        <p class="case__eyebrow">{c.eyebrow}</p>
        <h3 id="case-title" class="case__title">{c.title}</h3>
        <p class="case__summary">{c.summary}</p>

        <h4 class="eyebrow case__sub">{c.ownLabel}</h4>
        <ul role="list" class="case__bullets">
          {c.bullets.map((b) => <li>{b}</li>)}
        </ul>
        <ul role="list" class="chips case__stack">{c.stack.map((s) => <li>{s}</li>)}</ul>
      </div>

      <div class="case__side">
        <dl class="meta">
          {c.meta.map((m) => <div><dt>{m.k}</dt><dd>{m.v}</dd></div>)}
        </dl>

        <figure class="perf">
          <figcaption>
            <span class="perf__title">{c.perfLabel}</span>
            <span class="perf__legend" aria-hidden="true">
              <span><i class="sw sw--before"></i>{c.perfLegend.before}</span>
              <span><i class="sw sw--after"></i>{c.perfLegend.after}</span>
            </span>
          </figcaption>
          <table class="perf__table">
            <caption class="sr-only">{c.perfCaption}</caption>
            <thead class="sr-only"><tr><th scope="col">{c.perfScreen}</th><th scope="col">{c.perfLegend.before}</th><th scope="col">{c.perfLegend.after}</th></tr></thead>
            <tbody>
              {perf.map((p) => (
                <tr class="perf__row" title={`${c.perfNames[p.id]}: ${p.before} → ${p.after} (+${p.after - p.before})`}>
                  <th scope="row">{c.perfNames[p.id]}<span class="perf__gain" aria-hidden="true">+{p.after - p.before}</span></th>
                  <td><span class="bar bar--before" style={`--v:${p.before}`}></span><span class="val">{p.before}</span></td>
                  <td><span class="bar bar--after" style={`--v:${p.after}`}></span><span class="val">{p.after}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="perf__note">{c.perfCaption}</p>
        </figure>
      </div>
    </article>

    <h3 class="eyebrow rows__label">{t.rowsLabel}</h3>
    <ol role="list" class="rows">
      {t.rows.map((r) => (
        <li class="row" data-reveal>
          <p class="row__period">{r.period}<span>{r.place}</span></p>
          <div class="row__body">
            <h4 class="row__org">{r.org}{r.note && <span class="row__note">{r.note}</span>}</h4>
            {r.role && <p class="row__role">{r.role}</p>}
            <p class="row__text">{r.text}</p>
            <ul role="list" class="chips">{r.stack.map((s) => <li>{s}</li>)}</ul>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .case { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 0; overflow: hidden; }
  .case__main { padding: clamp(24px, 3.4vw, 44px); }
  .case__side { padding: clamp(24px, 3.4vw, 44px); background: color-mix(in srgb, var(--fg) 3.5%, var(--card)); display: grid; gap: 28px; align-content: start; }
  .case__eyebrow { font-size: 15px; font-weight: 600; color: var(--accent); }
  .case__title { margin-top: 10px; font-size: clamp(28px, 3vw, 40px); font-weight: 700; letter-spacing: -0.035em; }
  .case__summary { margin-top: 16px; font-size: 19px; line-height: 1.45; color: var(--muted); font-weight: 500; max-width: 62ch; }
  .case__sub { margin-top: 32px; }
  .case__bullets { margin-top: 14px; display: grid; gap: 10px; }
  .case__bullets li { position: relative; padding-left: 22px; color: var(--fg-2); font-size: 17px; line-height: 1.55; max-width: 64ch; }
  .case__bullets li::before { content: ''; position: absolute; left: 2px; top: 0.55em; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); opacity: 0.9; }
  .case__stack { margin-top: 28px; }

  .meta { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .meta div { background: var(--surface); border-radius: 14px; padding: 14px 16px; display: grid; gap: 2px; }
  .meta dt { font-size: 13px; color: var(--muted); }
  .meta dd { font-size: 16px; font-weight: 600; }

  /* Lighthouse chart: a real table, drawn as paired bars */
  .perf { display: grid; gap: 14px; }
  .perf figcaption { display: grid; gap: 10px; }
  .perf__title { font-size: 15px; font-weight: 600; }
  .perf__legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 13px; color: var(--fg-2); }
  .perf__legend span { display: inline-flex; align-items: center; gap: 6px; }
  .sw { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }
  .sw--before, .bar--before { background: var(--mark-before); }
  .sw--after, .bar--after { background: linear-gradient(90deg, var(--grad-a), var(--grad-b)); }
  .perf__table { width: 100%; border-collapse: collapse; }
  .perf__row { display: grid; grid-template-columns: 1fr; gap: 4px; padding: 10px 10px; margin-inline: -10px; border-radius: 12px; transition: background-color 0.15s; }
  .perf__row:hover { background: var(--surface); }
  .perf__row th { text-align: left; font-size: 13.5px; font-weight: 550; display: flex; justify-content: space-between; margin-bottom: 4px; }
  .perf__gain { font-size: 13px; color: var(--accent); font-weight: 600; }
  .perf__row td { display: grid; grid-template-columns: minmax(0, 1fr) 28px; align-items: center; gap: 10px; }
  .bar { height: 8px; width: calc(var(--v) * 1%); border-radius: 999px; }
  .val { font-size: 12.5px; color: var(--fg-2); font-variant-numeric: tabular-nums; text-align: right; }
  .perf__note { font-size: 12.5px; color: var(--muted); }

  .rows__label { margin-top: clamp(72px, 8vw, 112px); margin-bottom: 8px; font-size: clamp(28px, 3vw, 40px); font-weight: 700; letter-spacing: -0.035em; color: var(--fg); }
  .row { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: 8px 32px; padding: 36px 0; border-bottom: 1px solid var(--line); }
  .row:first-child { border-top: 1px solid var(--line); }
  .row__period { font-size: 15px; font-weight: 500; color: var(--fg-2); display: grid; gap: 4px; align-content: start; padding-top: 4px; font-variant-numeric: tabular-nums; }
  .row__period span { color: var(--muted); }
  .row__org { font-size: 24px; font-weight: 700; letter-spacing: -0.02em; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; }
  .row__note { font-size: 13.5px; font-weight: 400; letter-spacing: 0; color: var(--muted); }
  .row__role { margin-top: 4px; font-size: 15px; font-weight: 550; color: var(--accent); }
  .row__text { margin-top: 10px; color: var(--fg-2); font-size: 17px; max-width: 74ch; }
  .row .chips { margin-top: 14px; }

  @media (max-width: 960px) {
    .case { grid-template-columns: 1fr; }
    .case__side { border-left: 0; }
  }
  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr; padding: 24px 0; }
    .meta { grid-template-columns: 1fr 1fr; }
  }
</style>
