---
import { copy, site, type Lang } from '../i18n/content';
import { hasCv } from '../lib/cv';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = copy[lang];
const home = lang === 'es' ? '/es/' : '/';
---
<header class="nav" data-nav>
  <div class="nav__inner wrap">
    <a href={home} class="nav__logo">
      <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="currentColor"/><path d="M5 16h4.5l2.5-7 4.5 14 3.5-10 2.5 3H27" fill="none" stroke="var(--bg)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>{site.name}</span>
    </a>
    <nav aria-label={lang === 'es' ? 'Principal' : 'Main'}>
      <ul role="list" class="nav__links">
        <li class="nav__opt"><a href="#experience">{t.nav.experience}</a></li>
        <li class="nav__opt"><a href="#work">{t.nav.work}</a></li>
        <li class="nav__opt"><a href="#about">{t.nav.about}</a></li>
        <li><a href={t.nav.switchHref} class="nav__lang" hreflang={lang === 'es' ? 'en' : 'es'} lang={lang === 'es' ? 'en' : 'es'}>{t.nav.switch}<span class="sr-only"> · {t.nav.switchLabel}</span></a></li>
        {hasCv && <li class="nav__opt"><a href={site.cv} class="btn" download>{t.cvShort}</a></li>}
        <li><a href="#contact" class="btn btn--primary">{t.nav.contact}</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .nav.is-scrolled { border-bottom-color: var(--line); }
  .nav__inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 64px; }
  .nav__logo { display: inline-flex; align-items: center; gap: 10px; font-weight: 650; font-size: 16px; letter-spacing: -0.015em; min-height: 44px; }
  .nav__logo svg { width: 28px; height: 28px; color: var(--fg); }
  .nav__links { display: flex; align-items: center; gap: 4px; font-size: 14.5px; font-weight: 500; }
  .nav__links a:not(.btn) { display: inline-flex; align-items: center; min-height: 44px; padding-inline: 10px; color: var(--fg-2); border-radius: 8px; transition: color 0.15s; }
  .nav__links a:not(.btn):hover { color: var(--fg); }
  .nav__links .btn { min-height: 38px; padding-inline: 14px; font-size: 14px; margin-left: 6px; }
  .nav__lang { font-family: var(--f-mono); font-size: 12.5px !important; }
  @media (max-width: 760px) {
    .nav__opt { display: none; }
  }
</style>
