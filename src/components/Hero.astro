---
import { copy, site, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const all = copy[lang];
const t = all.hero;
const longest = Math.max(...t.lines.map((l) => l.replace(/\*/g, '').length));
const fmt = (s: string) => s.replace(/\*(.+?)\*/g, '<em>$1</em>');
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner wrap">
    <div class="hero__top">
      <p class="hero__who hero__fade" style="--i:0"><span class="hero__name">{site.name}</span><span class="label">{t.kicker}</span></p>
      <p class="hero__status hero__fade" style="--i:1"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 14.5s-4.5-4.2-4.5-7.6a4.5 4.5 0 0 1 9 0c0 3.4-4.5 7.6-4.5 7.6z" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="6.9" r="1.6" fill="currentColor"/></svg>{t.location}</p>
    </div>

    <h1 id="hero-title" class="hero__title" style={`--chars:${longest}`}>
      <span class="sr-only">{site.name}. </span>
      {t.lines.map((line, i) => (
        <span class="line"><span class="line__in" style={`--i:${i}`} set:html={fmt(line)} /></span>
      ))}
    </h1>

    <canvas class="hero__scope" data-scope aria-hidden="true"></canvas>

    <div class="hero__bottom">
      <p class="hero__intro hero__fade" style="--i:4">{t.intro}</p>
      <div class="hero__actions hero__fade" style="--i:5">
        <a href={site.cv} class="btn btn--solid" download data-magnetic>
          {all.cv}
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v9M4 7.5 8 11.5l4-4M3 14h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="#experience" class="btn" data-magnetic>{t.experience}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v12M3 9l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <a href={site.linkedin} class="btn" data-magnetic rel="me noopener" target="_blank">LinkedIn<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <a href={site.github} class="btn" data-magnetic rel="me noopener" target="_blank">GitHub<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      </div>
    </div>

    <div class="hero__meta hero__fade" style="--i:6" aria-hidden="true">
      <span>{site.domain}</span>
      <span class="hero__scroll">{t.scroll}<i></i></span>
      <span>React · TypeScript · Next.js</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    padding-top: 96px;
    padding-bottom: 28px;
    isolation: isolate;
    overflow: clip;
  }
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -2;
    background:
      radial-gradient(60% 50% at 80% 10%, rgb(124 107 255 / 0.16), transparent 70%),
      radial-gradient(50% 40% at 10% 90%, rgb(200 255 61 / 0.08), transparent 70%);
  }
  .hero__scope {
    position: relative; z-index: -1; display: block; max-width: none;
    width: calc(100% + 2 * var(--gutter)); height: clamp(110px, 17vh, 190px);
    margin: -24px calc(-1 * var(--gutter));
  }
  .hero__inner { display: flex; flex-direction: column; justify-content: space-between; gap: 40px; }
  .hero__top { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .hero__status {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 13px; color: var(--fg-2);
    border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px 6px 10px;
    background: rgb(255 255 255 / 0.03);
  }
  .hero__who { display: grid; gap: 10px; }
  .hero__name { font-family: var(--f-display); font-size: clamp(22px, 2vw, 30px); font-weight: 600; letter-spacing: -0.03em; }
  .hero__status svg { width: 15px; height: 15px; color: var(--accent); flex: none; }

  .hero__title {
    /* Fit the longest line on one row: about 0.44em per character, plus the 0.9em indent. */
    font-size: min(120px, 7vw, calc((100vw - 2 * var(--gutter)) / (var(--chars) * 0.44 + 0.9)));
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.055em;
    font-variation-settings: 'wdth' 82;
    text-wrap: initial;
  }
  .line { display: block; overflow: clip; padding-bottom: 0.06em; margin-bottom: -0.06em; white-space: nowrap; }
  .line__in {
    display: inline-block;
    animation: rise 1.4s var(--ease-out) both;
    animation-delay: calc(0.15s + var(--i) * 0.11s);
  }
  .line:nth-child(3) .line__in { padding-left: 0.9em; }
  .line:nth-child(4) .line__in { padding-left: 1.8em; }
  .hero__title :global(em) {
    font-style: normal;
    color: var(--accent);
    font-variation-settings: 'wdth' 100;
    font-weight: 700;
  }
  @keyframes rise { from { transform: translateY(105%) rotate(2deg); } to { transform: none; } }

  .hero__fade { animation: fade 1.2s var(--ease-out) both; animation-delay: calc(0.3s + var(--i) * 0.1s); }
  @keyframes fade { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

  .hero__bottom { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 32px; align-items: end; }
  .hero__intro { max-width: 40ch; font-size: clamp(17px, 1.3vw, 21px); color: var(--fg-2); line-height: 1.5; }
  .hero__actions { display: flex; gap: 10px; flex-wrap: wrap; }

  .hero__meta {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding-top: 20px; border-top: 1px solid var(--line);
    font-family: var(--f-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted);
  }
  .hero__scroll { display: inline-flex; align-items: center; gap: 10px; }
  .hero__scroll i { width: 1px; height: 22px; background: var(--line-2); position: relative; overflow: hidden; }
  .hero__scroll i::after { content: ''; position: absolute; left: 0; right: 0; top: 0; height: 40%; background: var(--accent); animation: drip 1.8s var(--ease-in-out) infinite; }
  @keyframes drip { from { transform: translateY(-100%); } to { transform: translateY(260%); } }

  @media (max-width: 860px) {
    .hero__bottom { grid-template-columns: 1fr; }
    .hero__scope { height: clamp(110px, 26vw, 200px); margin: -12px calc(-1 * var(--gutter)); }
    .hero__inner { gap: 28px; }
    .line:nth-child(3) .line__in, .line:nth-child(4) .line__in { padding-left: 0; }
  }
  @media (max-width: 560px) {
    .hero__actions { display: grid; grid-template-columns: 1fr 1fr; }
    .hero__actions .btn { justify-content: center; padding-inline: 12px; }
    .hero__name { font-size: 22px; }
    .hero__title { font-size: min(40px, calc((100vw - 2 * var(--gutter)) / (var(--chars) * 0.45))); }
    .hero__meta span:first-child, .hero__meta span:last-child { display: none; }
    .hero__meta { justify-content: center; }
  }
</style>
