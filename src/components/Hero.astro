---
import { copy, site, perf, type Lang } from '../i18n/content';
import { hasCv } from '../lib/cv';
interface Props { lang: Lang }
const { lang } = Astro.props;
const all = copy[lang];
const t = all.hero;
const r = all.release;
const fmt = (s: string) => s.replace(/\*(.+?)\*/g, '<em>$1</em>');
const dash = perf[0];
const icon = {
  mail: '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3.5h12v9H2zM2.5 4l5.5 4.5L13.5 4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>',
  dl: '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8.5M4.5 7 8 10.5 11.5 7M3 13.5h10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  out: '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11l6-6M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>',
};
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__head wrap">
    <p class="hero__role">{t.kicker}</p>
    <h1 id="hero-title" class="hero__title"><span class="sr-only">{site.name}. </span><Fragment set:html={fmt(t.title)} /></h1>
    <p class="hero__intro">{t.intro}</p>
    <div class="hero__actions">
      {site.email[lang] && <a href={`mailto:${site.email[lang]}`} class="btn btn--primary"><Fragment set:html={icon.mail} />{t.email}</a>}
      {hasCv && <a href={site.cv} class="btn" download><Fragment set:html={icon.dl} />{all.cv}</a>}
    </div>
    <p class="hero__social">
      <a href={site.linkedin} class="link" rel="me noopener" target="_blank">LinkedIn<Fragment set:html={icon.out} /></a>
      <a href={site.github} class="link" rel="me noopener" target="_blank">GitHub<Fragment set:html={icon.out} /></a>
    </p>
    <p class="hero__loc"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 14.5s-4.5-4.2-4.5-7.6a4.5 4.5 0 0 1 9 0c0 3.4-4.5 7.6-4.5 7.6z" fill="none" stroke="currentColor" stroke-width="1.4"/><circle cx="8" cy="6.9" r="1.6" fill="currentColor"/></svg>{t.location}</p>
  </div>

  <div class="hero__bento wrap">
    <aside class="release card" aria-labelledby="release-title" data-reveal>
      <div class="release__head">
        <div>
          <p class="eyebrow">{r.label}</p>
          <h2 id="release-title" class="release__title">{r.title}</h2>
        </div>
        <span class="release__badge"><i aria-hidden="true"></i>{r.badge}</span>
      </div>
      <ol role="list" class="release__steps">
        {r.steps.map((s) => (
          <li>
            <span class="release__dot" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M4 8.3 6.8 11 12 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="release__k">{s.k}</span>
            <span class="release__v">{s.v}</span>
          </li>
        ))}
      </ol>
      <p class="release__foot">
        <span>{r.foot}</span>
        <span class="release__delta"><s aria-hidden="true">{dash.before}</s><span class="sr-only">{dash.before} → </span><b>{dash.after}</b><span class="release__up" aria-hidden="true">+{dash.after - dash.before}</span></span>
      </p>
    </aside>

    <dl class="facts">
      {t.facts.map((f) => (
        <div class="fact card" data-reveal><dt>{f.label}</dt><dd>{f.value}</dd></div>
      ))}
    </dl>
  </div>

  <div class="wrap clients">
    <p class="eyebrow">{t.clientsLabel}</p>
    <ul role="list">{t.clients.map((c) => <li>{c}</li>)}</ul>
  </div>
</section>

<style>
  .hero { --card: var(--tile); padding-top: clamp(72px, 10vw, 144px); padding-bottom: clamp(72px, 8vw, 120px); position: relative; isolation: isolate; }
  /* A faint wash of the accent behind the headline */
  .hero::before {
    content: ''; position: absolute; inset: -52px 0 auto; height: 900px; z-index: -1; pointer-events: none;
    background: radial-gradient(50% 45% at 50% 18%, var(--accent-soft), transparent 70%);
  }

  .hero__head { display: grid; justify-items: center; text-align: center; }
  .hero__head > * { animation: rise 1.1s var(--ease-out) both; }
  .hero__head > :nth-child(2) { animation-delay: 0.08s; }
  .hero__head > :nth-child(3) { animation-delay: 0.16s; }
  .hero__head > :nth-child(n + 4) { animation-delay: 0.24s; }

  .hero__role { font-size: clamp(17px, 1.6vw, 21px); font-weight: 600; letter-spacing: -0.015em; color: var(--accent); }
  .hero__title {
    margin-top: 14px;
    font-size: clamp(44px, 8vw, 96px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.045em;
    max-width: 15ch;
  }
  .hero__title :global(em) {
    font-style: normal;
    color: var(--accent);
    background: linear-gradient(100deg, var(--grad-a) 10%, var(--grad-b) 90%);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    padding-bottom: 0.06em;
  }
  .hero__intro { margin-top: 28px; font-size: clamp(19px, 1.7vw, 23px); line-height: 1.42; font-weight: 500; letter-spacing: -0.015em; color: var(--muted); max-width: 40em; }
  .hero__actions { margin-top: 36px; display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; }
  .hero__actions .btn { min-height: 48px; padding-inline: 26px; font-size: 17px; }
  .hero__social { margin-top: 14px; display: flex; gap: 4px 28px; justify-content: center; }
  .hero__loc { margin-top: 18px; font-size: 14px; color: var(--muted); }
  .hero__loc svg { display: inline-block; vertical-align: -2px; margin-right: 6px; width: 14px; height: 14px; }

  /* Bento: release card beside four fact tiles */
  .hero__bento { margin-top: clamp(72px, 9vw, 128px); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; }

  .release { padding: clamp(24px, 3vw, 36px); }
  .release__head { display: flex; justify-content: space-between; align-items: start; gap: 12px; padding-bottom: 18px; }
  .release__title { margin-top: 6px; font-size: clamp(24px, 2.4vw, 30px); font-weight: 700; letter-spacing: -0.03em; }
  .release__badge { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: var(--accent); padding: 5px 11px; border-radius: 999px; background: var(--accent-soft); white-space: nowrap; }
  .release__badge i { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .release__steps { padding-block: 6px; }
  .release__steps li { display: grid; grid-template-columns: 24px minmax(0, 1fr); column-gap: 14px; padding-block: 9px; position: relative; }
  .release__steps li:not(:last-child)::after { content: ''; position: absolute; left: 11.5px; top: 35px; bottom: -7px; width: 1px; background: var(--line-2); }
  .release__dot { grid-row: span 2; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; background: var(--accent-fill); color: #fff; }
  .release__dot svg { width: 14px; height: 14px; }
  .release__k { font-size: 16px; font-weight: 600; }
  .release__v { font-size: 14px; color: var(--muted); }
  .release__foot { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-top: 16px; margin-top: 8px; border-top: 1px solid var(--line); font-size: 14px; color: var(--fg-2); }
  .release__delta { display: inline-flex; align-items: baseline; gap: 8px; font-variant-numeric: tabular-nums; }
  .release__delta s { color: var(--muted); font-size: 14px; }
  .release__delta b { font-size: 24px; font-weight: 700; color: var(--fg); letter-spacing: -0.02em; }
  .release__up { font-size: 13px; font-weight: 600; color: var(--accent); }

  /* Facts as tiles: number big at the bottom, Apple spec-sheet style */
  .facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .fact { padding: clamp(22px, 2.4vw, 30px); display: flex; flex-direction: column-reverse; justify-content: flex-start; gap: 6px; min-height: 180px; }
  .fact dd { font-size: clamp(40px, 4.6vw, 60px); font-weight: 700; letter-spacing: -0.045em; line-height: 1; font-variant-numeric: tabular-nums; margin-top: auto; }
  .fact:first-child dd { color: var(--accent); background: linear-gradient(100deg, var(--grad-a), var(--grad-b)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .fact dt { font-size: 15px; font-weight: 500; color: var(--muted); line-height: 1.35; }
  .facts .fact:nth-child(2) { transition-delay: 0.06s; }
  .facts .fact:nth-child(3) { transition-delay: 0.12s; }
  .facts .fact:nth-child(4) { transition-delay: 0.18s; }

  .clients { margin-top: clamp(48px, 6vw, 72px); display: grid; justify-items: center; gap: 14px; text-align: center; }
  .clients ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 32px; }
  .clients li { font-size: 19px; font-weight: 600; color: var(--fg-2); letter-spacing: -0.02em; }

  @media (max-width: 960px) {
    .hero__bento { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .facts { gap: 12px; }
    .fact { min-height: 150px; }
    .hero__actions { display: grid; width: 100%; }
    .hero__title { max-width: 11ch; }
    .hero__intro { font-size: 18px; }
  }
</style>
