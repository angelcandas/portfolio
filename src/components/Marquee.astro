---
import { copy, type Lang } from '../i18n/content';
interface Props { lang: Lang }
const items = copy[Astro.props.lang].marquee;
---
<div class="marquee" role="presentation">
  <p class="sr-only">{items.join(', ')}</p>
  <div class="marquee__track" aria-hidden="true">
    {[0, 1].map(() => (
      <ul class="marquee__group">
        {items.map((it) => <li>{it}<span class="star">✳</span></li>)}
      </ul>
    ))}
  </div>
</div>

<style>
  .marquee {
    border-block: 1px solid var(--line);
    padding-block: clamp(18px, 2.4vw, 30px);
    overflow: hidden;
    background: var(--bg-2);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee__track { display: flex; width: max-content; animation: marquee 38s linear infinite; }
  .marquee:hover .marquee__track { animation-play-state: paused; }
  .marquee__group { display: flex; list-style: none; padding: 0; }
  .marquee__group li {
    display: inline-flex; align-items: center; gap: clamp(20px, 3vw, 44px); padding-right: clamp(20px, 3vw, 44px);
    font-family: var(--f-display); font-size: clamp(28px, 4.4vw, 64px); font-weight: 500; letter-spacing: -0.04em;
    font-variation-settings: 'wdth' 85; white-space: nowrap;
  }
  .marquee__group li:nth-child(even) { color: transparent; -webkit-text-stroke: 1px var(--fg-2); }
  .star { color: var(--accent); font-size: 0.5em; -webkit-text-stroke: 0; }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .marquee__track { animation: none; } }
</style>
