---
import Base from '../layouts/Base.astro';
import { copy } from '../i18n/content';
const t = copy.en.notFound;
const te = copy.es.notFound;
---
<Base lang="en" title={`404 · ${t.title}`} noindex>
  <main id="main" class="nf wrap">
    <p class="eyebrow">404</p>
    <h1>{t.title}</h1>
    <p>{t.body} <span lang="es">{te.body}</span></p>
    <a class="btn btn--primary" href="/">{t.back}</a>
  </main>
</Base>
<style>
  .nf { min-height: 100svh; display: grid; align-content: center; gap: 24px; }
  .nf h1 { font-size: clamp(44px, 7vw, 88px); font-weight: 700; letter-spacing: -0.045em; }
  .nf p:not(.label) { color: var(--fg-2); }
  .nf .btn { justify-self: start; }
</style>
